{
  "name": "resenha-desktop",
  "version": "1.0.0",
  "description": "App de desktop do 7M Hub",
  "main": "main.js",
  "author": "7M Hub",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.sevenmhub.app",
    "productName": "7M Hub",
    "files": [
      "main.js",
      "preload.js",
      "config.json",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false
  },
  "optionalDependencies": {
    "electron-native-screenshare": "1.2.0"
  }
}